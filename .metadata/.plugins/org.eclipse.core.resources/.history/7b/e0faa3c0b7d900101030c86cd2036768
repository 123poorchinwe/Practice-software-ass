

public class Goalkeeper {
	private String name;
    private int score=0;
    public Goalkeeper(String name) {
       
        this.name = name;
        
    }
    public String getName() {
    	return this.name;
    }
    public int getScore() {
    	return this.score;
    }
    public int addScore() {
    	return this.score=this.score+1;
	 
    }
}

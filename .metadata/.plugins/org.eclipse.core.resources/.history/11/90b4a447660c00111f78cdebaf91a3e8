

public class Player extends Entity{
	private int energy;
    public Player(int energy) {
        super(0, 0);
        this.energy=energy;
    }
	 //move the player,every step -1 energy
    @Override
	public void move(char direction, Map map) {
    	int newX=x;
        int newY=y;
        if(direction == 'W') 
        	newY++;
        if(direction == 'S') 
        	newY--;
        if(direction == 'A') 
        	newX--;
        if(direction == 'D') 
        	newX++;
        if(newX<0 || newY<0 || newX>=map.getSize() || newY>=map.getSize()) {
        	System.out.println("Leave the map!!!");
	        return;     
    }
        if(map.isWall(newX, newY)) {
            System.out.println("You hit a wall!");
            return;
        }
        if(direction == 'W') 
        	moveUp();
        if(direction == 'S') 
        	moveDown();
        if(direction == 'A') 
        	moveLeft();
        if(direction == 'D') 
        	moveRight();
        if(map.hasTreasure(x, y)) {
            System.out.println("Treasure, here!!");
            map.removeTreasure(x, y);
        }
    }
    public void moveLeft() {
        x--;
        energy--;
    }
	public void moveRight() {
        x++;
        energy--;
    }
	public void moveUp() {
        y++;
        energy--;
    }
	public void moveDown() {
        y--;
        energy--;
    }
	public int getX() {
        return x;
    }
	public int getY() {
        return y;
    }
	public int getEnergy() {
        return energy;
    }
       

}

